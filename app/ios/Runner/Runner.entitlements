<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app read the Wi-Fi name, so check-in can tell it is on the office network.
	     Needs "Access WiFi Information" enabled for the App ID in the Apple developer account. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
