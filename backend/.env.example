# Copy to .env and adjust.
DATABASE_URL="postgresql://postgres:hrdev@localhost:5433/sirena_hr"
# At least 32 random characters; the API refuses to start otherwise. e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=3000
# Address to listen on. Defaults to 127.0.0.1 when TRUST_PROXY=true (behind Caddy), else 0.0.0.0.
# HOST=0.0.0.0
# Where uploaded project files are stored on disk
FILES_DIR="./storage/files"
# Lunch booking closes at this local time on the day itself
MEAL_CUTOFF="10:30"
# Set to true when running behind Caddy so client IPs come from X-Forwarded-For
TRUST_PROXY=true
# Comma-separated browser origins allowed to call the API.
# Empty = any origin in development, none in production (TRUST_PROXY=true).
CORS_ORIGINS=""
